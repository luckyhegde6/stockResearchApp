# Individual-stock research
RESEARCH_INCLUDE_CHARTINK=false
DEBUG_CONSOLE=true

# News / sentiment
NEWS_ENABLE_GOOGLE_RSS=true
NEWS_TV_MAX_PAGES=3
NEWS_GOOGLE_MAX_ITEMS=40
NEWS_NSE_MAX_ITEMS=200
NEWS_MAX_STORED_HEADLINES=100

# TradingView symbol snapshot
# Fields are defined in src/adapters/tradingview-symbol-snapshot.ts

# Google Sheets export (optional; uses an Apps Script web-app sink)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
# Track command lifecycle locally and publish supported data artifacts when available; no command-run sheet is created.
# Requires URL + token. Set false to disable all automatic post-run Sheets publishing.
GOOGLE_SHEETS_AUTO_EXPORT=true
GOOGLE_SHEETS_ID=1YMKesB9CBnntEnLp-rznzuOOixWDwX6WaWqb-FmtRak
# Screenshot publishing limits. Images are resized to <=900,000 pixels and JPEG-compressed below the per-image blob limit before upload.
# MAX_SCREENSHOT_SOURCE_BYTES is the input-file safety cap; MAX_SCREENSHOT_BYTES is the compressed upload cap per image.
GOOGLE_SHEETS_MAX_SCREENSHOT_SOURCE_BYTES=20000000
GOOGLE_SHEETS_MAX_SCREENSHOT_BYTES=1400000
GOOGLE_SHEETS_MAX_SCREENSHOT_TOTAL_BYTES=5000000
GOOGLE_SHEETS_MAX_SCREENSHOTS=8

# Optional LLM boundary
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000

# TradingView public symbol-page surfaces captured directly with Playwright
TRADINGVIEW_UI_SURFACES=forecast,news,documents,seasonals,community
TRADINGVIEW_INITIAL_SETTLE_MS=8000
TRADINGVIEW_DIRECT_SURFACE_SETTLE_MS=5000
TRADINGVIEW_DIRECT_SURFACE_TIMEOUT_MS=120000
TRADINGVIEW_UI_CONFIRM_TIMEOUT_MS=10000
TRADINGVIEW_RANGE_SETTLE_MS=3000
